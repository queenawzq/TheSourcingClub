# The deploy needs the site source and api/ only. Everything below is either
# regenerated, local-only, or several megabytes of things a CDN should never
# be asked to hold.
node_modules
dist
.vite
e2e-evidence
*.log

# supabase/ is excluded except its migrations: the production build applies
# them (scripts/deploy-migrate.mjs) and needs nothing else from the folder.
supabase/*
!supabase/migrations

# scripts/ is NOT excluded: `npm run build` begins with
# `node scripts/check-css-tokens.mjs`, so excluding it fails the deploy with
# MODULE_NOT_FOUND. It did, between the commit that added this file and the
# commit that added the check.
