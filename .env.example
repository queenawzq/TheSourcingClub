# Copy to .env.local. `supabase start` prints the first two.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true only once a Google OAuth client is configured on the Supabase
# project; it just controls whether the button is shown.
VITE_GOOGLE_AUTH_ENABLED=false

# Whether the "fill in the rest from this" button appears on the RFQ composer.
# Must be set TOGETHER with OPENROUTER_API_KEY below: on its own it shows a
# button that can only fail, and without it the key is never reachable.
VITE_AI_BRIEF_ENABLED=false

# Server-side only, and deliberately NOT VITE_ prefixed so it can never reach
# the browser bundle. Locally the Vite dev server loads it into process.env for
# the /api shim; in production it is set in the Vercel project, not here.
# Used by api/generate-brief.js and api/translate.js.
OPENROUTER_API_KEY=
# Optional. Defaults to anthropic/claude-opus-5.
OPENROUTER_MODEL=
