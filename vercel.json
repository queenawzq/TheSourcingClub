{
  "buildCommand": "npm run build && node scripts/deploy-migrate.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/app.html/(.*)",
      "destination": "/app.html"
    }
  ]
}
