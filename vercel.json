{
  "buildCommand": "npm run build && node scripts/deploy-migrate.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/app.html/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/sb/wxzliajdtwekqdvwzqfb/:path*",
      "destination": "https://wxzliajdtwekqdvwzqfb.supabase.co/:path*"
    },
    {
      "source": "/sb/lafsvocxthdoryezikdb/:path*",
      "destination": "https://lafsvocxthdoryezikdb.supabase.co/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sb/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 7 * * *"
    }
  ]
}
